<?xml version="1.0"?>
<robot name="grass">

  <link name="world"/>

  <joint name="world_fix" type="fixed">
    <parent link="world"/><child link="base_link"/>
    <origin xyz="0 0 0.5"/>
  </joint>

  <!-- base with a fixed column (visual only) -->
  <link name="base_link">
    <visual><geometry><cylinder radius="0.06" length="0.05"/></geometry></visual>
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry><cylinder radius="0.02" length="0.30"/></geometry>
    </visual>
  </link>

  <!-- Z: the whole arm slides up and down on the column -->
  <joint name="z_joint" type="prismatic">
    <parent link="base_link"/><child link="carriage"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 0 1"/>
    <limit lower="0" upper="0.2" effort="50" velocity="0.05"/>
  </joint>
  <link name="carriage">
    <visual><geometry><box size="0.08 0.08 0.03"/></geometry></visual>
  </link>

  <!-- J1: spins arm 1 -->
  <joint name="j1" type="revolute">
    <parent link="carriage"/><child link="arm1"/>
    <origin xyz="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.4" upper="2.4" effort="10" velocity="1.5"/>
  </joint>
  <link name="arm1">
    <visual><origin xyz="0.13 0 0.02"/><geometry><box size="0.26 0.04 0.02"/></geometry></visual>
  </link>

  <!-- J2: elbow at the end of arm 1 -->
  <joint name="j2" type="revolute">
    <parent link="arm1"/><child link="arm2"/>
    <origin xyz="0.26 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" effort="10" velocity="1.5"/>
  </joint>
  <link name="arm2">
    <visual><origin xyz="0.17 0 0.04"/><geometry><box size="0.34 0.04 0.02"/></geometry></visual>
  </link>

  <!-- tcp = tip of the robot, where the camera is -->
  <joint name="tcp_joint" type="fixed">
    <parent link="arm2"/><child link="tcp"/>
    <origin xyz="0.34 0 0"/>
  </joint>
  <link name="tcp">
    <visual><geometry><sphere radius="0.015"/></geometry></visual>
  </link>

</robot>
